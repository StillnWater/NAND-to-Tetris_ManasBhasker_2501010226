// Program Counter. Priority: reset > load > inc > hold.
CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];

    PARTS:
    Inc16(in=prev, out=prevPlus1);
    Mux16(a=prev, b=prevPlus1, sel=inc,   out=m1);
    Mux16(a=m1,   b=in,        sel=load,  out=m2);
    Mux16(a=m2,   b=false,     sel=reset, out=m3);
    Register(in=m3, load=true, out=out, out=prev);
}
